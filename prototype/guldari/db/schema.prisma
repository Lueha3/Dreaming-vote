// 굴다리(Guldari) 콘서트 앱 — Prisma 스키마
// DB는 기존 레포(Blue-Humanity, prisma/schema.prisma)와 물리적으로 분리된
// 전용 Supabase 프로젝트(guldari, drwrrabpcfixpvzwmlii)다. 실제 테이블·트리거·
// RLS·CHECK 제약은 001_init_schema.sql / 002_hardening.sql로 이미 적용돼 있고,
// 이 파일은 그 구조를 1:1로 반영한 타입 레이어일 뿐이다 — 여기서 스키마를
// 변경하지 말 것(반드시 SQL 마이그레이션 → 이 파일 순서로 동기화).
//
// 생성/적용 명령 (루트 schema.prisma와 별개 — --schema로 명시):
//   npx prisma generate --schema=prototype/guldari/db/schema.prisma
//   npx prisma validate --schema=prototype/guldari/db/schema.prisma
// db push/migrate는 쓰지 않는다 — 트리거·advisory lock·CHECK 제약이 SQL로만
// 표현 가능해 Supabase MCP apply_migration으로 직접 적용한다(ENV_EXAMPLE.md의
// 기존 레포 관례와 동일).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "../../../src/generated/guldari-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("GULDARI_DATABASE_URL") // pooler 6543
  directUrl = env("GULDARI_DIRECT_URL") // direct 5432
  schemas   = ["public", "auth"]
}

// Supabase Auth의 auth.users를 참조하기 위한 최소 스텁 — 이 프로젝트는 auth.users를
// 관리하지 않는다(Supabase Auth SDK 전용). id 컬럼만 있으면 profiles와의 FK 관계
// 선언에 충분하다.
model AuthUser {
  id      String   @id @db.Uuid
  profile Profile?

  @@map("users")
  @@schema("auth")
}

// profiles — Supabase Auth 사용자의 앱 확장 정보. verified_ci/abuse_flag는
// trustWeight() DB 함수(신뢰가중치 산정)의 원재료.
model Profile {
  id           String    @id @db.Uuid
  nickname     String
  avatarConfig Json      @default("{}") @map("avatar_config")
  verifiedCi   Boolean   @default(false) @map("verified_ci") // 본인인증(CI) 완료 여부
  abuseFlag    Boolean   @default(false) @map("abuse_flag") // 어뷰징 클러스터 판정(수동/배치)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // 소프트 삭제 — sp_ledger 등 감사 기록이 no-action FK로 보호되어 활동 이력이
  // 있는 계정은 auth.users 하드 delete가 애초에 막힌다. 탈퇴는 이 컬럼으로 처리.
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  authUser         AuthUser          @relation(fields: [id], references: [id], onDelete: Cascade)
  artistProfile    ArtistProfile?
  attendances      Attendance[]
  spLedgerEntries  SpLedger[]
  fanRegistrations FanRegistration[]

  @@map("profiles")
  @@schema("public")
}

// artist_profiles — T0 취미 / T1 파트너 / T2 어워드 수상자(03-economy-design.md §1-2).
model ArtistProfile {
  userId           String   @id @map("user_id") @db.Uuid
  stageName        String   @map("stage_name")
  bio              String?
  popularityScore  Decimal  @default(0) @map("popularity_score") @db.Decimal
  // T0_HOBBY | T1_PARTNER | T2_AWARD
  tier             String   @default("T0_HOBBY")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile              Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs                Song[]
  setlists             Setlist[]
  concerts             Concert[]        @relation("HeadlinerConcerts")
  openingConcerts      Concert[]        @relation("OpeningGuestConcerts")
  fanRegistrations     FanRegistration[]
  payoutLedgerEntries  PayoutLedger[]
  seasonScores         SeasonScore[]

  @@map("artist_profiles")
  @@schema("public")
}

// songs — 요구사항 2: 자작곡/AI곡(저작권 클리어 시), 검수 상태머신.
model Song {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artistId         String   @map("artist_id") @db.Uuid
  title            String
  durationSeconds  Int      @map("duration_seconds")
  audioUrl         String?  @map("audio_url")
  hlsUrl           String?  @map("hls_url")
  // ORIGINAL | AI_GENERATED
  sourceType       String   @map("source_type")
  aiTool           String?  @map("ai_tool") // 예: "Suno Pro" — sourceType='AI_GENERATED'일 때 참고용
  // PENDING | FINGERPRINT_FLAGGED | APPROVED | REJECTED
  reviewStatus     String   @default("PENDING") @map("review_status")
  acrResult        Json?    @map("acr_result") // ACRCloud 등 핑거프린트 검수 원본 응답
  aiProbability    Decimal? @map("ai_probability") @db.Decimal(4, 3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6) // DB 트리거(set_updated_at)가 최종 권위

  artist       ArtistProfile  @relation(fields: [artistId], references: [userId])
  setlistItems SetlistItem[]

  @@map("songs")
  @@schema("public")
}

// setlists / setlist_items — 요구사항 1: 최대 15곡. PK(setlist_id, position)이
// position 1~15 CHECK와 결합해 16번째 자리 자체가 존재하지 않는다(물리적 상한).
model Setlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artistId  String   @map("artist_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  artist   ArtistProfile @relation(fields: [artistId], references: [userId])
  items    SetlistItem[]
  concerts Concert[]

  @@map("setlists")
  @@schema("public")
}

model SetlistItem {
  setlistId String @map("setlist_id") @db.Uuid
  songId    String @map("song_id") @db.Uuid
  position  Int    @db.SmallInt // CHECK 1..15 (DB)

  setlist Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  song    Song    @relation(fields: [songId], references: [id])

  @@id([setlistId, position])
  @@unique([setlistId, songId]) // 같은 곡 중복 편성 방지
  @@map("setlist_items")
  @@schema("public")
}

// venues — 06-venues-and-discovery.md §4 티어 리스킨: 길 위 → 스타디움.
model Venue {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  // T0_STREET | T1_SPOT | T2_CLUB | T3_FESTIVAL | T4_STADIUM
  tier            String
  capacity        Int
  sceneAssetKey   String?  @map("scene_asset_key") // 클라이언트 3D 맵 애셋 식별자(예: 'guldari', 'rooftop')
  physicsProfile  Json     @default("{}") @map("physics_profile")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  concerts Concert[]

  @@map("venues")
  @@schema("public")
}

// concerts — 오프닝 게스트는 15곡 한도와 별도(01-concept-and-features.md §2-4).
// status가 LIVE로 바뀌는 UPDATE 시 DB 트리거가 셋리스트 전 곡 APPROVED 여부를 재확인한다.
model Concert {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artistId               String    @map("artist_id") @db.Uuid
  setlistId              String    @map("setlist_id") @db.Uuid
  venueId                String    @map("venue_id") @db.Uuid
  scheduledAt            DateTime  @map("scheduled_at") @db.Timestamptz(6)
  // DRAFT | FUNDED | LIVE | ENDED | CANCELLED
  status                 String    @default("DRAFT")
  fundingCostSp          Int       @default(0) @map("funding_cost_sp")
  effectsTimeline        Json      @default("[]") @map("effects_timeline") // 연출 시퀀서 큐
  openingGuestArtistId   String?   @map("opening_guest_artist_id") @db.Uuid
  openingGuestSongCount  Int?      @map("opening_guest_song_count") @db.SmallInt // CHECK 1..3 (DB)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  artist        ArtistProfile  @relation("HeadlinerConcerts", fields: [artistId], references: [userId])
  setlist       Setlist        @relation(fields: [setlistId], references: [id])
  venue         Venue          @relation(fields: [venueId], references: [id])
  openingGuest  ArtistProfile? @relation("OpeningGuestConcerts", fields: [openingGuestArtistId], references: [userId])
  stats         ConcertStats?
  attendances   Attendance[]
  ratings       Rating[]

  @@map("concerts")
  @@schema("public")
}

// concert_stats — 실시간 리더보드 롤업(Supabase Realtime 구독 대상).
// concertId 행은 Concert insert 시 DB 트리거가 자동 생성한다(앱에서 직접 create 금지).
// ratingCount/avgStars/weightedStars는 별점 등록/취소 시 트리거가 갱신한다 — 앱은
// peakCcu·encoreReached·encoreReachedAt만 update한다.
model ConcertStats {
  concertId        String    @id @map("concert_id") @db.Uuid
  peakCcu          Int       @default(0) @map("peak_ccu")
  ratingCount      Int       @default(0) @map("rating_count") // 트리거 관리
  avgStars         Decimal?  @map("avg_stars") @db.Decimal(2, 1) // 트리거 관리
  weightedStars    Decimal?  @map("weighted_stars") @db.Decimal // 트리거 관리(avg×log10(1+Σ신뢰가중))
  encoreReached    Boolean   @default(false) @map("encore_reached")
  encoreReachedAt  DateTime? @map("encore_reached_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  concert Concert @relation(fields: [concertId], references: [id], onDelete: Cascade)

  @@map("concert_stats")
  @@schema("public")
}

// attendances — 별점 자격의 근거(01 §5, 04 §5: 관람 60%+ 실재해야 평가권).
model Attendance {
  concertId      String   @map("concert_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt         DateTime? @map("left_at") @db.Timestamptz(6)
  shardId        String?  @map("shard_id") // 인스턴스 샤딩 식별자(02 §5)
  presenceRatio  Decimal? @map("presence_ratio") @db.Decimal(3, 2) // CHECK 0..1 (DB), >=0.6이어야 평가 가능(트리거)

  concert Concert  @relation(fields: [concertId], references: [id], onDelete: Cascade)
  profile Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 1:N — 같은 참석(concertId,userId)에 대해 세그먼트별(MAIN/OPENING) 평가가 최대 2건 있을 수 있다.
  ratings Rating[]

  @@id([concertId, userId])
  @@map("attendances")
  @@schema("public")
}

// ratings — UNIQUE(concert,user,segment) + attendances 복합 FK로 이중 방어.
// segment='OPENING'은 오프닝 게스트 무대 평가(1.5배 가중은 랭킹 배치가 집계 시 적용).
// 1회성 평가 — DB가 UPDATE를 append-only 정책으로 차단한다(취소는 delete만 가능).
model Rating {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  concertId      String   @map("concert_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  // MAIN | OPENING
  segment        String   @default("MAIN")
  stars          Int      @db.SmallInt // CHECK 1..5 (DB)
  bestMomentTs   Decimal? @map("best_moment_ts") @db.Decimal // '베스트 순간' 태깅 — 곡 재생 경과초
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  concert    Concert    @relation(fields: [concertId], references: [id], onDelete: Cascade)
  attendance Attendance @relation(fields: [concertId, userId], references: [concertId, userId], onDelete: Cascade)

  @@unique([concertId, userId, segment])
  @@map("ratings")
  @@schema("public")
}

// fan_registrations — "1호 팬" 메커니즘(01 §2-3). fanNumber는 DB 트리거
// (assign_fan_number, advisory lock으로 직렬화)가 항상 서버에서 채번해 덮어쓴다 —
// 클라이언트가 보낸 값은 무시되므로 create 시 아무 값이나 넣어도 무방.
model FanRegistration {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artistId  String   @map("artist_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  fanNumber Int      @default(0) @map("fan_number") // 트리거가 항상 재계산
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  artist  ArtistProfile @relation(fields: [artistId], references: [userId], onDelete: Cascade)
  profile Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([artistId, userId])
  @@unique([artistId, fanNumber])
  @@map("fan_registrations")
  @@schema("public")
}

// sp_ledger — 무상 리워드(SP) append-only 원장(04-risk-analysis.md §2: 현금화·양도·
// 환전 경로 없음). balanceAfter는 DB 트리거가 seq(진짜 삽입 순서) 기준으로 서버 계산해
// 항상 덮어쓴다 — 클라이언트는 amount/reason만 넣으면 된다. UPDATE/DELETE는 DB가 거부한다.
// VIEW_REWARD는 20, RATING_REWARD는 10으로 CHECK가 고정돼 있어 "별점 값과 무관한
// 리워드"(게임산업법 §28 사행성 회피 근거)가 스키마 레벨에서 보증된다.
model SpLedger {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seq           BigInt   @unique @default(autoincrement()) // balance_after 계산의 유일한 순서 기준
  userId        String   @map("user_id") @db.Uuid
  amount        Int // 양수=적립, 음수=차감(대관료 등)
  balanceAfter  Int      @default(0) @map("balance_after") // 트리거가 항상 재계산
  // VIEW_REWARD(=20) | RATING_REWARD(=10) | MISSION | ARTIST_SHOW_REWARD |
  // VENUE_FUNDING(음수) | PROMO_SPEND(음수) | SEASON_DECAY(음수)
  reason        String
  refId         String?  @map("ref_id") // 관련 concert_id/song_id 등(느슨한 참조, FK 미설정)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id])

  @@map("sp_ledger")
  @@schema("public")
}

// payout_ledger — 현금 정산(T1 파트너). SP 원장과 물리적으로 분리(04 §2 완화안 ③) —
// 이 모델과 SpLedger 사이엔 FK도 뷰도 없다(환전 경로 없음이 스키마 구조로 보증됨).
// net은 Postgres GENERATED ALWAYS AS (gross-fee-withholding) STORED 컬럼이라
// Prisma가 계산할 수 없다 — optional + dbgenerated("")로 선언해 create 시 절대
// 값을 보내지 않는다(보내면 DB가 에러 낸다).
model PayoutLedger {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artistId     String    @map("artist_id") @db.Uuid
  // SPONSOR_BOOST | MERCH | SEASON_PRIZE
  source       String
  gross        Decimal   @db.Decimal(12, 2)
  fee          Decimal   @default(0) @db.Decimal(12, 2)
  withholding  Decimal   @default(0) @db.Decimal(12, 2)
  net          Decimal?  @default(dbgenerated()) @db.Decimal(12, 2) // 절대 write하지 말 것 — DB 생성 컬럼
  period       String // 정산 대상 기간, 예: '2026-08'
  // PENDING | PAID
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt       DateTime? @map("paid_at") @db.Timestamptz(6)

  artist ArtistProfile @relation(fields: [artistId], references: [userId])

  @@map("payout_ledger")
  @@schema("public")
}

// ranking_seasons / season_scores — 요구사항 7: 분기 어워드.
model RankingSeason {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quarter   String   @unique // 예: '2026-Q3'
  startsAt  DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(6)
  // UPCOMING | ACTIVE | ENDED
  status    String   @default("UPCOMING")

  scores SeasonScore[]

  @@map("ranking_seasons")
  @@schema("public")
}

model SeasonScore {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId       String   @map("season_id") @db.Uuid
  artistId       String   @map("artist_id") @db.Uuid
  weightedScore  Decimal  @default(0) @map("weighted_score") @db.Decimal
  rank           Int?
  prizeTier      String?  @map("prize_tier")
  prizePaid      Boolean  @default(false) @map("prize_paid")

  season RankingSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  artist ArtistProfile @relation(fields: [artistId], references: [userId], onDelete: Cascade)

  @@unique([seasonId, artistId])
  @@map("season_scores")
  @@schema("public")
}
